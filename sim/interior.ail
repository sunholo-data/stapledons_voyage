-- Render HUD overlay for scene-based interior
pure func renderSceneHUD(state: InteriorState, nav: ShipNavigation) -> [DrawCmd] {
    let deckName = match state.currentDeck {
        SceneBridge => "Bridge",
        SceneObservation => "Observation Deck"
    };
    let velocityText = if nav.velocity < 0.01 then "Velocity: 0.0c"
                       else if nav.velocity < 0.3 then "Velocity: 0.2c"
                       else if nav.velocity < 0.6 then "Velocity: 0.5c"
                       else "Velocity: 0.8c";
    [
        Text(
            deckName,
            10.0, 20.0, 12, 4294967295, layerUI()
        ),
        Text(
            velocityText,
            10.0, 40.0, 12, 4294967295, layerUI()
        ),
        Text(
            "Tab: Switch Deck | V: Cycle Velocity | ESC: Exit",
            10.0, 60.0, 12, 4294967295, layerUI()
        )
    ]
}

-- Create ShipState3D command from navigation state
pure func renderShipState(nav: ShipNavigation) -> DrawCmd {
    let forward = getForward(nav);
    let up = getUp(nav);
    ShipState3D(
        nav.position.x, nav.position.y, nav.position.z,
        forward.x, forward.y, forward.z,
        up.x, up.y, up.z,
        nav.velocity, nav.grPhi
    )
}

-- Get sprite ID for current deck background
pure func getDeckSpriteId(deck: DeckSelection) -> int {
    match deck {
        SceneBridge => 9000,
        SceneObservation => 9001
    }
}

-- Convert SolarPlanet to DrawCmd
pure func planetToDrawCmd(p: SolarPlanet, z: int) -> DrawCmd {
    TexturedPlanet(p.name, p.posX, p.posY, p.radius, p.rotation, p.hasRings, p.ringColor, z)
}

-- Convert list of planets to DrawCmds recursively
pure func planetsToDrawCmds(planets: [SolarPlanet], z: int) -> [DrawCmd] {
    match planets {
        [] => [],
        p :: rest => planetToDrawCmd(p, z) :: planetsToDrawCmds(rest, z)
    }
}

-- Render a few key planets at visible screen positions for window view
-- These are manually positioned to be visible through the bridge/observation windows
pure func renderScenePlanets() -> [DrawCmd] {
    [
        -- Saturn (large, center-left window) - with golden rings
        TexturedPlanet("saturn", 400.0, 480.0, 120.0, 0.0, true, 3095314687, 5),
        -- Jupiter (large, center window)
        TexturedPlanet("jupiter", 640.0, 400.0, 100.0, 0.0, false, 0, 5),
        -- Mars (small, right window)
        TexturedPlanet("mars", 900.0, 500.0, 40.0, 0.0, false, 0, 5),
        -- Earth (medium, center-right)
        TexturedPlanet("earth", 800.0, 350.0, 60.0, 0.0, false, 0, 5)
    ]
}

-- Render bubble ship HUD (3rd-person external view)
-- Shows transparent bubble with ship silhouette, positioned in corner of screen
pure func renderBubbleShipHUD(nav: ShipNavigation) -> DrawCmd {
    -- Position in bottom-right corner
    let screenX = 0.75;   -- 75% from left
    let screenY = 0.70;   -- 70% from top (bottom area)
    let size = 200.0;     -- 200x200 pixel viewport
    let alpha = 0.25;     -- Semi-transparent bubble
    let showStars = true; -- Show stars through bubble

    BubbleShipHUD(screenX, screenY, size, alpha, nav.velocity, showStars, 200)
}

-- Render entire interior scene with ship navigation state
-- SCENE-BASED RENDERING (2D backgrounds + 3D solar system through transparent windows)
export pure func renderInterior(state: InteriorState, nav: ShipNavigation) -> [DrawCmd] {
    -- Ship state for SR/GR effects
    let shipState = renderShipState(nav);

    -- Space background (renders first, far behind everything)
    let spaceBg = SpaceBg(0);

    -- Manually positioned planets for window view (not orbital simulation)
    let planetCmds = renderScenePlanets();

    -- Deck background (2D scene with transparent windows)
    -- Renders in front of planets, so planets show through window regions
    let deckBackground = Ui(
        "deck-background",
        UiPortrait,
        0.0, 0.0,  -- Fullscreen
        1.0, 1.0,
        "",
        getDeckSpriteId(state.currentDeck),
        50,  -- Mid-layer (planets at z=5, deck at z=50)
        0,
        0.0
    );

    -- HUD overlay (renders on top)
    let hud = renderSceneHUD(state, nav);

    -- Bubble ship HUD (3rd-person external view in corner)
    let bubbleHud = renderBubbleShipHUD(nav);

    -- Combine all layers: ship state, space, planets, deck, HUD, bubble ship
    shipState :: spaceBg :: concat(planetCmds, concat([deckBackground], concat(hud, [bubbleHud])))
}
