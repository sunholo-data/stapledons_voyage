module sim/world

-- Import Coord from protocol (imports fixed in v0.4.9)
import sim/protocol (Coord)

-- Import NPC type from npc_ai (NPC now has MovementPattern)
import sim/npc_ai (NPC, MovementPattern, PatternStatic, PatternRandomWalk, PatternPatrol, Direction)

-- Import InteriorState from interior module (3D first-person view)
import sim/interior (InteriorState)

-- Import StarCatalog for galaxy map
import sim/starmap (StarCatalog)

-- Import StarSystem for solar system view
import sim/celestial (StarSystem)

-- Import ShipLevels for multi-deck navigation
import sim/ship_levels (ShipLevels)

-- Import ShipNavigation for galactic position/orientation
import sim/navigation (ShipNavigation)

-- Re-export NPC type for consumers
export type Tile = { biome: int }

-- Planet state (grid stored as flat list)
export type PlanetState = {
    width: int,
    height: int,
    tiles: [Tile]
}

-- Selection state (tagged union matching Go mock)
export type Selection =
    | SelectionNone
    | SelectionTile(int, int)  -- x, y tile coordinates

-- Game view mode (what screen to render)
export type ViewMode =
    | ViewInterior    -- 3D ship interior (first-person)
    | ViewPlanet      -- Planet surface (legacy test view)
    | ViewGalaxyMap   -- Galaxy navigation

-- Complete world state
export type World = {
    tick: int,
    planet: PlanetState,
    npcs: [NPC],
    selection: Selection,
    interior: InteriorState,
    viewMode: ViewMode,
    starCatalog: StarCatalog,
    currentSystem: StarSystem,
    shipLevels: ShipLevels,       -- Multi-deck ship navigation state
    shipNavigation: ShipNavigation -- Galactic position and orientation
}
